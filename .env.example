# Copy to .env and fill in. See the Configuration table in README.md.

# Required: the token MCP clients send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
REEL_API_TOKEN=

# Required: the public HTTPS address of this server (no trailing slash).
REEL_PUBLIC_BASE_URL=https://reel.example.com

# Optional: ElevenLabs voices (Edge voices are free and need nothing).
ELEVENLABS_API_KEY=

# Optional: a password the director types as {{secret:PANEL_PASSWORD}}.
# REEL_SECRET_PANEL_PASSWORD=

# Optional: where videos are kept on the host (default ./data) and the port.
# REEL_HOST_DATA_DIR=./data
# PORT=8000
